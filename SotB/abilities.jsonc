{
  "abilities": [
    {
      "ability": "...And I'm Always Right",
      "power_level": {
        "combat": 2,
        "social": 0,
        "general": 1
      },
      "desc": "Action; May make a Hard Leadership check; if successful, allies within medium range may perform a second maneuver during their turn without suffering strain; this character may spend ⋀ to increase the damage of affected allies' attacks by an amount equal to the ⋀ spent; both of these effects last until the end of this character's next turn.\nSource: Expanded Player's Guide",
      "ex": "Nemesis"
    },
    {
      "ability": "...They Pull You Back In",
      "power_level": {
        "combat": 0,
        "social": 1,
        "general": 0
      },
      "desc": "Action; After calling in a favor, this character may make an opposed Coercion versus Discipline check; if successful the target still owes this character a favor; :g!: means the target now owes a favor of one magnitude great than before.\nSource: Shadow of the Beanstalk",
      "ex": "Nemesis"
    },
    {

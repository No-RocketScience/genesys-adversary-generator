    {
      "ability": "Apex Predator",
      "power_level": {
        "combat": 2,
        "social": 1,
        "general": 0
      },
      "desc": "Passive; At the start of their first turn in the encounter, all opponents must make a Hard Discipline check as an out-of-turn incidental. If they fail, they are immobilized until the start of their next turn instead. If you’re using the fear rules (see GCRB page 243), this counts as a fear check, and other effects may apply as well.\nSource: Genesys Core Rulebook",
      "ex": "Nemesis"
    },
    {
      "ability": "Apparent Precognition",
      "power_level": {
        "combat": 1,
        "social": 0,
        "general": 0
      },
      "desc": "Passive; Once per encounter when making a combat check, may use Discipline and Willpower instead of the normal skill and characteristic.\nSource: Shadow of the Beanstalk",
      "ex": "Nemesis"
    },
    {
      "ability": "Aquatic",
      "power_level": {
        "combat": 0,
        "social": 0,
